{%- comment -%}
  横向卡片轮播（精选研究）
  数据来源：_data/featured_research.yml
  特性：左右箭头 / 滚动条拖动 / 鼠标按住卡片拖拽 / 触摸板横滑
{%- endcomment -%}
<div class="fc-wrap">
  <style>
    .fc-wrap { position: relative; }
    .fc-scroll {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 4px 4px 12px 4px;
      cursor: grab;
      scrollbar-width: thin; /* Firefox */
    }
    .fc-scroll.dragging { cursor: grabbing; scroll-snap-type: none; }
    .fc-card {
      flex: 0 0 250px;
      scroll-snap-align: start;
      text-decoration: none;
      color: inherit;
      background-color: var(--global-card-bg-color, #fff);
      border: 1px solid var(--global-divider-color, #dee2e6);
      border-radius: 6px;
      overflow: hidden;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.16), 0 2px 10px rgba(0, 0, 0, 0.12);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .fc-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12), 0 4px 10px rgba(0, 0, 0, 0.1);
      text-decoration: none;
    }
    .fc-card img {
      display: block;
      width: 100%;
      height: 150px;
      object-fit: cover;
      pointer-events: none; /* 让拖拽事件不被图片吞掉 */
    }
    .fc-body { padding: 0.75rem 0.9rem 0.9rem; }
    .fc-title { font-weight: 500; font-size: 1rem; margin: 0 0 0.25rem; }
    .fc-sub { color: var(--global-text-color-light, #747373); font-size: 0.85rem; }
    .fc-nav {
      position: absolute;
      top: 40%;
      width: 34px;
      height: 34px;
      border: none;
      border-radius: 50%;
      background: var(--global-card-bg-color, #fff);
      color: var(--global-text-color, #212529);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      font-size: 1rem;
      cursor: pointer;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .fc-nav:hover { background: var(--global-theme-color, #7a9e9f); color: #fff; }
    .fc-prev { left: -12px; }
    .fc-next { right: -12px; }
    @media (max-width: 576px) { .fc-nav { display: none; } }
    /* 拉动条样式 */
    .fc-scroll::-webkit-scrollbar { height: 8px; }
    .fc-scroll::-webkit-scrollbar-track {
      background: var(--global-divider-color, #e9ecef);
      border-radius: 4px;
    }
    .fc-scroll::-webkit-scrollbar-thumb {
      background: var(--global-theme-color, #9c9c9c);
      border-radius: 4px;
    }
    .fc-scroll::-webkit-scrollbar-thumb:hover { filter: brightness(1.2); }
  </style>

  <button class="fc-nav fc-prev" aria-label="上一个">&#10094;</button>
  <div class="fc-scroll" id="fc-scroll">
    {% for item in site.data.featured_research %}
      <a class="fc-card" href="{{ item.url | default: '#' }}">
        <img
          src="{{ item.image | relative_url }}"
          alt="{{ item.title }}"
          loading="lazy"
          onerror="this.onerror=null;this.src='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22600%22 height=%22400%22%3E%3Crect width=%22600%22 height=%22400%22 fill=%22%23e9ecef%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 font-size=%2248%22 text-anchor=%22middle%22 dominant-baseline=%22middle%22 fill=%22%23adb5bd%22%3E%F0%9F%96%BC%20%E9%85%8D%E5%9B%BE%E5%BE%85%E6%B7%BB%E5%8A%A0%3C/text%3E%3C/svg%3E'"
        >
        <div class="fc-body">
          <div class="fc-title">{{ item.title }}</div>
          {% if item.sub %}<div class="fc-sub">{{ item.sub }}</div>{% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
  <button class="fc-nav fc-next" aria-label="下一个">&#10095;</button>

  <script>
    (function () {
      var scroller = document.getElementById('fc-scroll');
      if (!scroller) return;
      var wrap = scroller.closest('.fc-wrap');

      // 左右箭头
      wrap.querySelector('.fc-prev').addEventListener('click', function () {
        scroller.scrollBy({ left: -540, behavior: 'smooth' });
      });
      wrap.querySelector('.fc-next').addEventListener('click', function () {
        scroller.scrollBy({ left: 540, behavior: 'smooth' });
      });

      // 鼠标按住拖拽
      var isDown = false,
        startX = 0,
        startScroll = 0,
        moved = false;
      scroller.addEventListener('pointerdown', function (e) {
        if (e.pointerType !== 'mouse') return; // 触屏用原生滑动
        isDown = true;
        moved = false;
        startX = e.clientX;
        startScroll = scroller.scrollLeft;
        scroller.classList.add('dragging');
      });
      window.addEventListener('pointermove', function (e) {
        if (!isDown) return;
        var dx = e.clientX - startX;
        if (Math.abs(dx) > 5) moved = true;
        scroller.scrollLeft = startScroll - dx;
      });
      window.addEventListener('pointerup', function () {
        if (!isDown) return;
        isDown = false;
        scroller.classList.remove('dragging');
      });
      // 拖拽过的卡片不触发点击跳转
      scroller.addEventListener(
        'click',
        function (e) {
          if (moved) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );
    })();
  </script>
</div>
