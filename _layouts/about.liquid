---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {%- comment -%}
      左右两栏布局：照片与联系信息固定在左栏，正文内容固定在右栏，
      文字不会环绕到照片下方。窄屏（<576px）时两栏自动变为上下排列。
      正文中插入 <!-- split --> 注释可把内容分成两段：
      注释之前的内容显示在照片右侧，之后的内容全宽显示在照片下方。
      两栏宽度比例由 .about-photo-col / .about-text-col 控制（之和须为 100%）。
    {%- endcomment -%}
    <style>
      @media (min-width: 576px) {
        .about-photo-col { flex: 0 0 32%; max-width: 32%; }
        .about-text-col { flex: 0 0 68%; max-width: 68%; }
      }
      /* 主题默认给 .profile 设了 width:30%，会让照片在栏内再缩小一次，这里取消 */
      .about-photo-col .profile { width: 100%; }
    </style>
    {% if page.profile %}
      {% assign content_parts = content | split: '<!-- split -->' %}
      <div class="row">
        <div class="col-sm-4 about-photo-col">
          <div class="profile">
            {% if page.profile.image %}
              {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
              {% if page.profile.image_circular %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
              {% else %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
              {% endif %}
              {%
                include figure.liquid loading="eager" path=profile_image_path class=profile_image_class alt=page.profile.image
                cache_bust=true
              %}
            {% endif %}
            {% if page.profile.more_info %}
              <div class="more-info">{{ page.profile.more_info }}</div>
            {% endif %}
          </div>
        </div>
        <div class="col-sm-8 about-text-col">
          {{ content_parts[0] }}
        </div>
      </div>
      {% if content_parts.size > 1 %}
        <div class="clearfix mt-3">{{ content_parts.last }}</div>
      {% endif %}
    {% else %}
      <div class="clearfix">{{ content }}</div>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit"><span class="lang-zh">最新动态</span><span class="lang-en">News</span></a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit"><span class="lang-zh">最新文章</span><span class="lang-en">Latest Posts</span></a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit"><span class="lang-zh">代表性论文</span><span class="lang-en">Selected Publications</span></a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
